# ── Smartstack Messenger — переменные окружения ──────────────────────────────

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://messenger:messenger@localhost:5432/messenger?schema=public

# Секрет подписи JWT токенов мессенджера (kind='messenger'). ОБЯЗАТЕЛЬНО смените.
JWT_SECRET=change-me-to-a-long-random-string

# Токен администратора для управления аккаунтами (Authorization: Bearer <token>).
ADMIN_TOKEN=change-me-admin-token

# Время жизни access-токена мессенджера.
JWT_ACCESS_TTL=30d

# Файловое хранилище вложений: local | minio.
# При FILE_STORAGE=local (или если MINIO_ENDPOINT пуст) используется локальный диск.
FILE_STORAGE=local
LOCAL_STORAGE_DIR=./uploads

# Порт HTTP-сервера.
PORT=3000

# ── Необязательно: MinIO / S3 (если FILE_STORAGE=minio) ──────────────────────
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin

# ── Необязательно: публикация наружу через cloudflared ───────────────────────
# PUBLISH_TARGET=http://server:3000
# TUNNEL_METRICS_URL=http://cloudflared:2000
